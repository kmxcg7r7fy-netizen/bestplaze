# URL du projet (Settings → API dans Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Clé anon (optionnelle, pour usage client futur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — uniquement côté serveur, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Afficher /admin/demo en build production (sinon : utiliser uniquement `npm run dev`)
# NEXT_PUBLIC_ADMIN_DEMO=true
